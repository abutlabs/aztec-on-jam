+// jam-privacy-service#46/#61: the deferred IPA discharge of a CHONK batch. Each proof leaves a
+// NativeAccumulator (15 round challenges and a claimed G_0); batch_verify_accumulators checks N of them
+// with one 2^15-point SRS MSM. The cost does not depend on the values, so the accumulators are random
+// (the check itself fails; only its time is measured).
+void ipa_batch_discharge(State& state) noexcept
+{
+    numeric::RNG& engine = numeric::get_debug_randomness();
+    using Acc = IPA<Curve>::NativeAccumulator;
+    std::vector<Acc> accs(static_cast<size_t>(state.range(0)));
+    for (auto& acc : accs) {
+        for (size_t i = 0; i < CONST_ECCVM_LOG_N; ++i) {
+            acc.u_challenges_inv.push_back(Fr::random_element(&engine));
+        }
+        acc.claimed_commitment = vk.get_monomial_points()[1];
+        acc.relation_succeeded = true;
+    }
+    for (auto _ : state) {
+        benchmark::DoNotOptimize(IPA<Curve>::batch_verify_accumulators(vk, std::span<const Acc>(accs)));
+    }
+}
+
